NODE_ENV=development
PORT=5000

# Local dev database (see README → Database setup)
DATABASE_URL=postgresql://sprasa:sprasa_dev_2026@localhost:5432/sprasa_hr?schema=public
# Used only by integration tests. Created automatically by `npm run test` if the role has CREATEDB.
TEST_DATABASE_URL=postgresql://sprasa:sprasa_dev_2026@localhost:5432/sprasa_hr_test?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

FRONTEND_URL=http://localhost:5173
# Extra allowed CORS origins, comma separated
CORS_ORIGINS=

# SMTP. Leave SMTP_HOST empty in development: emails are written to the log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Sprasa HR <no-reply@sprasatechnicalsolution.com.np>"

# Private storage for uploaded files. Never serve this directory statically.
UPLOAD_DIR=../uploads
MAX_FILE_SIZE=5242880
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Backups
BACKUP_DIR=../backups
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 2 * * *
PG_DUMP_PATH=pg_dump

# Background jobs (document expiry, backups). Set false on extra app instances.
ENABLE_JOBS=true
LOG_LEVEL=info
